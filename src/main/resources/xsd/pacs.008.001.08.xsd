<?xml version="1.0" encoding="UTF-8"?>
<!--
  Representative, scoped-down model of ISO 20022 pacs.008.001.08
  (FIToFICustomerCreditTransferV08). See pain.001.001.09.xsd for the
  scoping note that applies to every schema in this project.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
           xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           jaxb:version="3.0">

    <xs:annotation>
        <xs:appinfo>
            <jaxb:schemaBindings>
                <jaxb:package name="com.bank.iso20022converter.model.pacs00800108"/>
            </jaxb:schemaBindings>
        </xs:appinfo>
    </xs:annotation>

    <xs:element name="Document" type="Document"/>

    <xs:complexType name="Document">
        <xs:sequence>
            <xs:element name="FIToFICstmrCdtTrf" type="FIToFICustomerCreditTransferV08"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FIToFICustomerCreditTransferV08">
        <xs:sequence>
            <xs:element name="GrpHdr" type="GroupHeader"/>
            <xs:element name="CdtTrfTxInf" type="CreditTransferTransaction" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GroupHeader">
        <xs:sequence>
            <xs:element name="MsgId" type="xs:string"/>
            <xs:element name="CreDtTm" type="xs:dateTime"/>
            <xs:element name="NbOfTxs" type="xs:string"/>
            <xs:element name="SttlmInf" type="SettlementInstruction"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SettlementInstruction">
        <xs:sequence>
            <!-- SttlmMtd values per base ISO 20022: INDA, INGA, COVE, CLRG -->
            <xs:element name="SttlmMtd" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CreditTransferTransaction">
        <xs:sequence>
            <xs:element name="PmtId" type="PaymentIdentification"/>
            <xs:element name="IntrBkSttlmAmt" type="ActiveCurrencyAndAmount"/>
            <xs:element name="IntrBkSttlmDt" type="xs:date"/>
            <xs:element name="ChrgBr" type="xs:string" minOccurs="0"/>
            <xs:element name="InstgAgt" type="FinancialInstitution"/>
            <xs:element name="InstdAgt" type="FinancialInstitution"/>
            <xs:element name="IntrmyAgt1" type="FinancialInstitution" minOccurs="0"/>
            <xs:element name="DbtrAgt" type="FinancialInstitution"/>
            <xs:element name="Dbtr" type="PartyIdentification"/>
            <xs:element name="DbtrAcct" type="CashAccount" minOccurs="0"/>
            <xs:element name="CdtrAgt" type="FinancialInstitution"/>
            <xs:element name="Cdtr" type="PartyIdentification"/>
            <xs:element name="CdtrAcct" type="CashAccount" minOccurs="0"/>
            <xs:element name="RmtInf" type="RemittanceInformation" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PaymentIdentification">
        <xs:sequence>
            <xs:element name="InstrId" type="xs:string" minOccurs="0"/>
            <xs:element name="EndToEndId" type="xs:string"/>
            <xs:element name="TxId" type="xs:string" minOccurs="0"/>
            <xs:element name="UETR" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ActiveCurrencyAndAmount">
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attribute name="Ccy" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="PartyIdentification">
        <xs:sequence>
            <xs:element name="Nm" type="xs:string"/>
            <xs:element name="PstlAdr" type="PostalAddress" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PostalAddress">
        <xs:sequence>
            <xs:element name="StrtNm" type="xs:string" minOccurs="0"/>
            <xs:element name="BldgNb" type="xs:string" minOccurs="0"/>
            <xs:element name="PstCd" type="xs:string" minOccurs="0"/>
            <xs:element name="TwnNm" type="xs:string" minOccurs="0"/>
            <xs:element name="Ctry" type="xs:string"/>
            <xs:element name="AdrLine" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CashAccount">
        <xs:sequence>
            <xs:element name="IBAN" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FinancialInstitution">
        <xs:sequence>
            <xs:element name="BICFI" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RemittanceInformation">
        <xs:sequence>
            <xs:element name="Ustrd" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
